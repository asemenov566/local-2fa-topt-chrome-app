{
  "name": "chrome-app-totp",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/core.test.mjs tests/pin-crypto.test.mjs tests/device-key.test.mjs",
    "test:browser": "node tests/run-browser-tests.cjs",
    "build:vendor": "node scripts/build-vendor.cjs",
    "build:icons": "node scripts/build-icons.cjs",
    "build:native": "powershell -NoProfile -File native/Build.ps1",
    "test:native": "node --test tests/native.test.cjs",
    "test:native:browser": "node tests/native-browser.cjs",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Release.ps1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zxing-wasm": "3.1.6"
  },
  "license": "MIT"
}
